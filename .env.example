# Server-only placeholders. Never prefix secrets with VITE_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
YOUVERSION_APP_KEY=
BIBLE_BRAIN_API_KEY=
ESV_API_KEY=
API_BIBLE_KEY=

# Public Appwrite configuration, safe in the browser.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_COMMUNITY_FUNCTION_ID=

# Public optional AI backend origin. Leave blank to use same-origin /api/ai.
VITE_AI_API_BASE_URL=

# Worker-only public configuration lives in wrangler.jsonc.
# SCRIPTURESMART_AI_MODEL
# SCRIPTURESMART_AI_FALLBACK_MODEL
# APPWRITE_ENDPOINT
# APPWRITE_PROJECT_ID
# ALLOWED_ORIGINS
# Wrangler uses its own login; no Cloudflare credential belongs here.
